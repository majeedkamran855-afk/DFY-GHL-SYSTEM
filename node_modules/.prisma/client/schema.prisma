// ============================================================
// WholesaleOS — Property-First Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ORGANIZATIONS, WORKSPACES & USERS (Multi-Tenant + RBAC)
// ============================================================

model Organization {
  id               String   @id @default(uuid())
  name             String
  planTier         PlanTier @default(STARTER)
  stripeCustomerId String?
  createdAt        DateTime @default(now())

  workspaces Workspace[]
  users      User[]
  buyers     Buyer[]
  properties Property[]
  numbers    PhoneNumber[]
  campaigns  Campaign10DLC[]
}

enum PlanTier {
  STARTER
  GROWTH
  SCALE
  ENTERPRISE
}

// Workspace = Market/Territory (e.g. "Phoenix Metro", "Dallas-Fort Worth")
model Workspace {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  targetZipCodes String[]
  timezone       String       @default("America/Chicago")

  properties Property[]
  users      WorkspaceMember[]
  deals      Deal[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String       @unique
  name           String
  role           Role
  phoneExtension String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  workspaces    WorkspaceMember[]
  assignedDeals Deal[]            @relation("DealAssignee")
  callLogs      CallLog[]
}

enum Role {
  ADMIN
  ACQUISITIONS_MANAGER
  LEAD_MANAGER
  DISPO_MANAGER
  COLD_CALLER
  TC // Transaction Coordinator
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  role        Role

  @@unique([workspaceId, userId])
}

// ============================================================
// PROPERTY (THE ANCHOR ENTITY)
// ============================================================

model Property {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id])

  apn          String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zip          String
  county       String?
  latitude     Float?
  longitude    Float?

  propertyType  PropertyType
  bedrooms      Int?
  bathrooms     Decimal?
  squareFootage Int?
  lotSizeSqft   Int?
  yearBuilt     Int?

  estimatedValue       Decimal? // AVM output, updated periodically
  estimatedValueSource String? // "internal_avm" | "batchdata" | "manual"
  mortgageBalanceEst   Decimal?
  equityPercentEst     Decimal?

  distressTags  DistressTag[]
  vacant        Boolean       @default(false)
  absenteeOwner Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owners        PropertyOwner[]
  mortgages     MortgageRecord[]
  deals         Deal[]
  offers        Offer[]
  comps         ComparableSale[] @relation("SubjectPropertyComps")
  skipTraceRuns SkipTraceRun[]
  activities    Activity[]

  @@unique([organizationId, apn, zip])
  @@index([organizationId, zip])
  @@index([organizationId, apn])
}

enum PropertyType {
  SINGLE_FAMILY
  MULTI_FAMILY_2_4
  MULTI_FAMILY_5_PLUS
  CONDO
  TOWNHOME
  MOBILE_MANUFACTURED
  LAND
  COMMERCIAL
}

enum DistressTag {
  PRE_FORECLOSURE
  TAX_LIEN
  TAX_DELINQUENT
  PROBATE
  VACANT
  ABSENTEE_OWNER
  CODE_VIOLATION
  BANKRUPTCY
  DIVORCE
  EVICTION
  INHERITED
  HIGH_EQUITY
  LOW_EQUITY_UNDERWATER
  EXPIRED_LISTING
  FSBO
  TIRED_LANDLORD
}

// Junction: a Property can have multiple Owners over time (history preserved)
model PropertyOwner {
  id             String    @id @default(uuid())
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id])
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id])
  ownershipType  String? // "individual" | "trust" | "LLC" | "estate"
  isCurrentOwner Boolean   @default(true)
  ownershipStart DateTime?
  ownershipEnd   DateTime?

  @@index([propertyId])
  @@index([contactId])
}

model MortgageRecord {
  id               String    @id @default(uuid())
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id])
  lenderName       String?
  originalAmount   Decimal?
  originationDate  DateTime?
  estimatedBalance Decimal?
  loanType         String? // "conventional" | "FHA" | "VA" | "hard_money"
  isPrimary        Boolean   @default(true)
  source           String?
  createdAt        DateTime  @default(now())
}

// ============================================================
// CONTACTS / OWNERS / SKIP TRACING
// ============================================================

model Contact {
  id              String          @id @default(uuid())
  organizationId  String
  firstName       String?
  lastName        String?
  entityName      String? // for LLC/trust owners
  mailingAddress1 String?
  mailingCity     String?
  mailingState    String?
  mailingZip      String?
  emails          ContactEmail[]
  phones          ContactPhone[]
  properties      PropertyOwner[]
  deals           Deal[]
  skipTraceRuns   SkipTraceRun[]
  createdAt       DateTime        @default(now())

  @@index([organizationId, lastName])
}

model ContactPhone {
  id              String    @id @default(uuid())
  contactId       String
  contact         Contact   @relation(fields: [contactId], references: [id])
  phoneNumber     String
  phoneType       String? // "mobile" | "landline"
  isDNC           Boolean   @default(false)
  dncCheckedAt    DateTime?
  isPrimary       Boolean   @default(false)
  confidenceScore Int? // skip-trace match confidence 0-100

  @@index([phoneNumber])
}

model ContactEmail {
  id        String  @id @default(uuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])
  email     String
  isPrimary Boolean @default(false)
}

model SkipTraceRun {
  id             String    @id @default(uuid())
  organizationId String
  propertyId     String?
  property       Property? @relation(fields: [propertyId], references: [id])
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id])
  provider       String // "batchdata" | "lexisnexis" | "first_american"
  requestPayload Json
  rawResponse    Json // stored in Mongo in practice; FK/pointer here
  matchCount     Int
  costCents      Int
  createdAt      DateTime  @default(now())
}

// ============================================================
// DEALS / PIPELINE
// ============================================================

model Deal {
  id               String    @id @default(uuid())
  organizationId   String
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id])
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id])
  primaryContactId String
  primaryContact   Contact   @relation(fields: [primaryContactId], references: [id])
  assignedUserId   String?
  assignedUser     User?     @relation("DealAssignee", fields: [assignedUserId], references: [id])

  stage       DealStage @default(NEW_LEAD)
  leadSource  String? // "cold_call" | "direct_mail" | "ppc" | "referral" | "driving_for_dollars"
  motivation  String?
  askingPrice Decimal?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  closedAt   DateTime?
  lostReason String?

  offers       Offer[]
  contracts    Contract[]
  activities   Activity[]
  stageHistory DealStageHistory[]

  @@index([organizationId, stage])
}

enum DealStage {
  NEW_LEAD
  COLD_CONTACTED
  SELLER_LEAD // engaged, motivation confirmed
  APPOINTMENT_SET
  OFFER_MADE
  UNDER_CONTRACT
  DISPO_ACTIVE // marketed to buyers
  BUYER_UNDER_CONTRACT // assignment/JV agreement signed with buyer
  CLOSING // at title/escrow
  CLOSED_WON
  CLOSED_LOST
}

model DealStageHistory {
  id              String     @id @default(uuid())
  dealId          String
  deal            Deal       @relation(fields: [dealId], references: [id])
  fromStage       DealStage?
  toStage         DealStage
  changedByUserId String?
  changedAt       DateTime   @default(now())
}

// ============================================================
// OFFERS / CONTRACTS / MAO CALCULATIONS
// ============================================================

model Offer {
  id         String   @id @default(uuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  arv                Decimal // After Repair Value (from AVM/Comps engine)
  repairEstimate     Decimal
  wholesaleFeeTarget Decimal
  maoFormula         String      @default("ARV_70") // versioned formula key
  maxAllowableOffer  Decimal // computed: (ARV * factor) - repairs - fee
  offerAmount        Decimal // actual amount presented to seller
  status             OfferStatus @default(DRAFT)
  presentedAt        DateTime?
  respondedAt        DateTime?

  createdAt DateTime @default(now())
}

enum OfferStatus {
  DRAFT
  PRESENTED
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Contract {
  id                   String         @id @default(uuid())
  dealId               String
  deal                 Deal           @relation(fields: [dealId], references: [id])
  contractType         ContractType
  purchasePrice        Decimal?
  assignmentFee        Decimal?
  emdAmount            Decimal?
  emdDueDate           DateTime?
  emdReceivedAt        DateTime?
  inspectionPeriodEnds DateTime?
  closingDate          DateTime?
  earnestMoneyHolder   String? // title co / escrow
  titleCompanyName     String?
  status               ContractStatus @default(DRAFTED)
  docSignEnvelopeId    String? // e-sign engine reference

  buyerAssignments BuyerAssignment[]

  createdAt DateTime @default(now())
}

enum ContractType {
  PURCHASE_AND_SALE
  ASSIGNMENT_CONTRACT
  ADDENDUM
  DOUBLE_CLOSE_PACKAGE
  NOVATION_AGREEMENT
  SUBJECT_TO_ADDENDUM
}

enum ContractStatus {
  DRAFTED
  SENT_FOR_SIGNATURE
  PARTIALLY_SIGNED
  FULLY_EXECUTED
  VOIDED
  CLOSED
}

// ============================================================
// BUYERS / DISPOSITION
// ============================================================

model Buyer {
  id                     String         @id @default(uuid())
  organizationId         String
  organization           Organization   @relation(fields: [organizationId], references: [id])
  contactId              String?
  companyName            String?
  buyBoxZips             String[]
  buyBoxPropertyTypes    PropertyType[]
  minBudget              Decimal?
  maxBudget              Decimal?
  minBeds                Int?
  strategy               String[] // ["fix_and_flip", "buy_and_hold", "wholesale_to_wholesale"]
  pofStatus              POFStatus      @default(NOT_PROVIDED)
  pofDocumentUrl         String?
  pofExpiresAt           DateTime?
  vipTier                Boolean        @default(false)
  dealsClosedCount       Int            @default(0)
  avgResponseTimeMinutes Int?

  assignments BuyerAssignment[]
  createdAt   DateTime          @default(now())

  @@index([organizationId, vipTier])
}

enum POFStatus {
  NOT_PROVIDED
  SUBMITTED
  VERIFIED
  EXPIRED
}

model BuyerAssignment {
  id                  String    @id @default(uuid())
  contractId          String
  contract            Contract  @relation(fields: [contractId], references: [id])
  buyerId             String
  buyer               Buyer     @relation(fields: [buyerId], references: [id])
  offerToBuyerAmount  Decimal
  assignmentFeeAmount Decimal
  status              String    @default("proposed") // proposed | accepted | funded | closed
  emdReceivedAt       DateTime?
  createdAt           DateTime  @default(now())
}

// ============================================================
// COMPARABLE SALES (AVM)
// ============================================================

model ComparableSale {
  id                String   @id @default(uuid())
  subjectPropertyId String
  subjectProperty   Property @relation("SubjectPropertyComps", fields: [subjectPropertyId], references: [id])
  compAddress       String
  compLatitude      Float
  compLongitude     Float
  distanceMiles     Decimal
  soldPrice         Decimal
  soldDate          DateTime
  squareFootage     Int
  bedrooms          Int?
  bathrooms         Decimal?
  yearBuilt         Int?
  daysOnMarket      Int?
  source            String // "mls" | "public_record" | "batchdata"
  similarityScore   Decimal? // 0-1, from vector similarity
  includedInAvm     Boolean  @default(true)
  createdAt         DateTime @default(now())
}

// ============================================================
// COMMUNICATIONS (referenced by CRM, sharded heavily by org)
// ============================================================

model PhoneNumber {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  e164           String         @unique
  areaCode       String
  provider       String // "telnyx" | "twilio"
  campaignId     String?
  campaign       Campaign10DLC? @relation(fields: [campaignId], references: [id])
  healthScore    Int            @default(100)
  status         String         @default("active") // active | flagged | retired
}

model Campaign10DLC {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  tcrBrandId     String
  tcrCampaignId  String
  useCase        String // "MIXED" | "REAL_ESTATE"
  throughputTier Int
  numbers        PhoneNumber[]
}

model Activity {
  id             String    @id @default(uuid())
  organizationId String
  propertyId     String?
  property       Property? @relation(fields: [propertyId], references: [id])
  dealId         String?
  deal           Deal?     @relation(fields: [dealId], references: [id])
  type           String // "call" | "sms" | "rvm" | "email" | "stage_change" | "note"
  direction      String? // "inbound" | "outbound"
  payload        Json
  createdAt      DateTime  @default(now())

  @@index([organizationId, createdAt])
}

model CallLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  toNumber     String
  fromNumber   String
  durationSec  Int?
  recordingUrl String?
  transcript   String?
  createdAt    DateTime @default(now())
}
